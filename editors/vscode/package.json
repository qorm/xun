{
  "name": "vscode-xun",
  "displayName": "XUN Language Support",
  "description": "Syntax highlighting and language support for XUN (X Unquoted Notation)",
  "version": "0.1.4",
  "publisher": "qorm",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "xun",
    "configuration",
    "unquoted",
    "syntax",
    "highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qorm/xun.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "xun",
        "aliases": [
          "XUN",
          "xun"
        ],
        "extensions": [
          ".xun"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xun",
        "scopeName": "source.xun",
        "path": "./syntaxes/xun.tmLanguage.json"
      }
    ]
  }
}
